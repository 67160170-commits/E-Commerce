# Run npm run setup to generate a private .env.local automatically.
# For deployment, set a unique random secret (at least 32 characters) in the host settings.
SESSION_SECRET=

# Optional absolute SQLite database path. The host must provide persistent storage.
# DATABASE_PATH=

# Optional password for a NEW seeded administrator; at least 12 characters.
# Seed generates random passwords and saves them in ignored data/local-accounts.txt by default.
# SEED_ADMIN_PASSWORD=
